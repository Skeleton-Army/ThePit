<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.shape.Rectangle?>

<HBox fx:id="gamepadBackground" styleClass="gamepad-panel" xmlns="http://javafx.com/javafx/8.0.172-ea"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="virtual_robot.controller.VirtualGamePadController">
    <children>
        <VBox alignment="CENTER">
            <children>
                <Button fx:id="btnLB" styleClass="gamepad-button, gamepad-bumper" alignment="BOTTOM_RIGHT" contentDisplay="CENTER"
                    mnemonicParsing="false" onMouseExited="#handleGamePadButtonMouseEvent"
                    onMousePressed="#handleGamePadButtonMouseEvent"
                    onMouseReleased="#handleGamePadButtonMouseEvent">
                    <VBox.margin>
                        <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                    </VBox.margin>
            </Button>
            <Slider fx:id="sldLeft" styleClass="gamepad-trigger" blockIncrement="0.001" majorTickUnit="0.001" max="1.0" maxHeight="75.0" onMousePressed="#handleTriggerMouseEvent" onMouseReleased="#handleTriggerMouseEvent" orientation="VERTICAL">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </Slider>
         </children>
      </VBox>
        <GridPane alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="40.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="40.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="40.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
         <HBox.margin>
            <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
         </HBox.margin>
         <children>
            <Button fx:id="btnDU" styleClass="gamepad-button, gamepad-dpad" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onMouseExited="#handleGamePadButtonMouseEvent" onMousePressed="#handleGamePadButtonMouseEvent" onMouseReleased="#handleGamePadButtonMouseEvent" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.valignment="CENTER" />
            <Button fx:id="btnDL" styleClass="gamepad-button, gamepad-dpad" mnemonicParsing="false" onMouseExited="#handleGamePadButtonMouseEvent" onMousePressed="#handleGamePadButtonMouseEvent" onMouseReleased="#handleGamePadButtonMouseEvent" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
            <Button fx:id="btnDR" styleClass="gamepad-button, gamepad-dpad" mnemonicParsing="false" onMouseExited="#handleGamePadButtonMouseEvent" onMousePressed="#handleGamePadButtonMouseEvent" onMouseReleased="#handleGamePadButtonMouseEvent" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
            <Button fx:id="btnDD" styleClass="gamepad-button, gamepad-dpad" mnemonicParsing="false" onMouseExited="#handleGamePadButtonMouseEvent" onMousePressed="#handleGamePadButtonMouseEvent" onMouseReleased="#handleGamePadButtonMouseEvent" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
         </children>
        </GridPane>

        <StackPane fx:id="joyStickLeftPane" alignment="TOP_LEFT" maxHeight="120.0" maxWidth="120.0" minHeight="120.0" minWidth="120.0" onMouseDragged="#handleJoystickMouseEvent" onMouseExited="#handleJoystickMouseEvent" onMousePressed="#handleJoystickMouseEvent" onMouseReleased="#handleJoystickMouseEvent" prefHeight="120.0" prefWidth="120.0">
            <children>
                <Rectangle fx:id="joystickLeftBg" arcHeight="5.0" arcWidth="5.0" height="120.0" strokeType="INSIDE" strokeWidth="3.0" width="120.0">
                    <StackPane.margin>
                        <Insets />
                    </StackPane.margin>
                </Rectangle>
                <Line fx:id="joystickLeftLineH" endX="60.0" endY="120.0" startX="60.0" StackPane.alignment="CENTER" />
                <Line fx:id="joystickLeftLineV" endX="120.0" endY="60.0" startY="60.0" StackPane.alignment="CENTER" />
                <Circle fx:id="joyStickLeftHandle" radius="10.0" strokeType="INSIDE" strokeWidth="0.0" translateX="50.0" translateY="50.0" />
            </children>
            <HBox.margin>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </HBox.margin>
        </StackPane>

        <StackPane fx:id="joyStickRightPane" alignment="TOP_LEFT" maxHeight="120.0" maxWidth="120.0" minHeight="120.0" minWidth="120.0" onMouseDragged="#handleJoystickMouseEvent" onMouseExited="#handleJoystickMouseEvent" onMousePressed="#handleJoystickMouseEvent" onMouseReleased="#handleJoystickMouseEvent" prefHeight="120.0" prefWidth="120.0">
            <children>
                <Rectangle fx:id="joystickRightBg" arcHeight="5.0" arcWidth="5.0" height="120.0" strokeType="INSIDE" strokeWidth="3.0" width="120.0" />
                <Line fx:id="joystickRightLineH" endX="60.0" endY="120.0" startX="60.0" StackPane.alignment="CENTER" />
                <Line fx:id="joystickRightLineV" endX="120.0" endY="60.0" startY="60.0" StackPane.alignment="CENTER" />
                <Circle fx:id="joyStickRightHandle" radius="10.0" strokeType="INSIDE" strokeWidth="0.0" translateX="50.0" translateY="50.0" />
            </children>
            <HBox.margin>
                <Insets bottom="5.0" top="5.0" />
            </HBox.margin>
        </StackPane>

        <GridPane alignment="CENTER">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="40.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="40.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="40.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Button fx:id="btnX" styleClass="gamepad-button, gamepad-btn-x" alignment="CENTER" mnemonicParsing="false" onMouseExited="#handleGamePadButtonMouseEvent" onMousePressed="#handleGamePadButtonMouseEvent" onMouseReleased="#handleGamePadButtonMouseEvent" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
                <Button fx:id="btnY" styleClass="gamepad-button, gamepad-btn-y" mnemonicParsing="false" onMouseExited="#handleGamePadButtonMouseEvent" onMousePressed="#handleGamePadButtonMouseEvent" onMouseReleased="#handleGamePadButtonMouseEvent" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
                <Button fx:id="btnA" styleClass="gamepad-button, gamepad-btn-a" mnemonicParsing="false" onMouseExited="#handleGamePadButtonMouseEvent" onMousePressed="#handleGamePadButtonMouseEvent" onMouseReleased="#handleGamePadButtonMouseEvent" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
                <Button fx:id="btnB" styleClass="gamepad-button, gamepad-btn-b" alignment="CENTER" mnemonicParsing="false" onMouseExited="#handleGamePadButtonMouseEvent" onMousePressed="#handleGamePadButtonMouseEvent" onMouseReleased="#handleGamePadButtonMouseEvent" GridPane.columnIndex="2" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
            </children>
            <HBox.margin>
                <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
            </HBox.margin>
        </GridPane>
      <VBox alignment="CENTER">
         <children>
            <Button fx:id="btnRB" styleClass="gamepad-button, gamepad-bumper" mnemonicParsing="false" onMouseExited="#handleGamePadButtonMouseEvent" onMousePressed="#handleGamePadButtonMouseEvent" onMouseReleased="#handleGamePadButtonMouseEvent">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </Button>
            <Slider fx:id="sldRight" styleClass="gamepad-trigger" blockIncrement="0.001" majorTickUnit="0.001" max="1.0" maxHeight="75.0" onMousePressed="#handleTriggerMouseEvent" onMouseReleased="#handleTriggerMouseEvent" orientation="VERTICAL">
               <VBox.margin>
                  <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
               </VBox.margin>
            </Slider>
         </children>
      </VBox>
    </children>

</HBox>
